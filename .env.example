# SmartTable AI Frontend Environment Configuration
# Copy this file to .env and configure your environment variables.

# ─── API & Backend Connection ──────────────────────────────────────────────────
# In development, Vite automatically proxies /api and socket.io to http://localhost:5000.
# In production or mobile apps (Capacitor/Cordova), set the absolute backend server URL:
# VITE_API_URL=http://localhost:5000

# ─── Google Maps Platform ──────────────────────────────────────────────────────
# 1. Prototyping: Get a free Maps Demo Key (no billing/cloud setup): https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentskills_v1
# 2. Production: Get an API Key from Google Cloud Console: https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentskills_v1
VITE_GOOGLE_MAPS_API_KEY=
