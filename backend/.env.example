# SmartTable AI – Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (SQLite) ─────────────────────────────────────────────────────────
# Optional: absolute or relative path to the SQLite database file.
# Defaults to ./database/smarttable.db (relative to the backend directory).
# DB_PATH=./database/smarttable.db

# ─── Authentication ────────────────────────────────────────────────────────────
# REQUIRED in production. Must be a long, random string (min 32 characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_key

# ─── Password Hashing ──────────────────────────────────────────────────────────
# bcrypt rounds (10 is the default — increase for higher security at cost of speed)
# BCRYPT_ROUNDS=10
