# SmartTable AI – Backend Environment Variables
# Copy this file to backend/.env and fill in your values.
# Never commit backend/.env to version control.

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Database (MySQL) ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smarttable

# ─── Authentication (JWT) ──────────────────────────────────────────────────────
# REQUIRED in production. Must be a long, random string (min 32 characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_secure_long_random_secret_key_minimum_32_characters

# ─── Password Hashing ──────────────────────────────────────────────────────────
BCRYPT_ROUNDS=10
